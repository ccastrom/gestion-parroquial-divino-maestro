<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Trámites de Bautismo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">Parroquia &mdash; Bautismos</a>
    </div>
  </nav>

  <div class="container py-4">
    <h2>Trámites de Bautismo</h2>
    <table class="table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Fecha ingreso</th>
          <th>Estado</th>
          <th>Fecha bautismo</th>
          <th>Reunion pre bautizo</th>
        </tr>
      </thead>
      <tbody>
        <% tramites.forEach(function(item){ %>
          <tr>
              <td><%= item.id %></td>
              <td><%= item.fecha_ingreso %></td>
              <td><%= item.estado %></td>
              <td><%= item.fecha_bautismo %></td>
              <td><%= item.id_fk_reunion_pre_bautizo %></td>
          </tr>
       <% }); %>

      </tbody>
    </table>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
