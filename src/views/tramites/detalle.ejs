<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Trámite #<%= tramite.id %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">Parroquia &mdash; Bautismos</a>
    </div>
  </nav>

  <div class="container py-4">

    <!-- Encabezado -->
    <div class="d-flex align-items-center gap-3 mb-4">
      <a href="/" class="btn btn-outline-secondary btn-sm">← Volver</a>
      <h2 class="mb-0">Trámite #<%= tramite.id %></h2>
      <span class="badge bg-secondary fs-6"><%= tramite.estado || 'Sin estado' %></span>
    </div>

    <!-- Datos del trámite -->
    <div class="card mb-4">
      <div class="card-header">Información del Trámite</div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-4">
            <small class="text-muted">Fecha ingreso</small>
            <p><%= tramite.fecha_ingreso || '—' %></p>
          </div>
          <div class="col-md-4">
            <small class="text-muted">Fecha bautismo</small>
            <p><%= tramite.fecha_bautismo || '—' %></p>
          </div>
          <div class="col-md-4">
            <small class="text-muted">Estado</small>
            <p><%= tramite.estado || '—' %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Participantes (próximamente) -->
    <div class="card mb-4">
      <div class="card-header">Participantes</div>
      <div class="card-body text-muted">
        Próximamente
      </div>
    </div>

    <!-- Reunión Prebautismal (próximamente) -->
    <div class="card mb-4">
      <div class="card-header">Reunión Prebautismal</div>
      <div class="card-body text-muted">
        Próximamente
      </div>
    </div>

    <!-- Documento (próximamente) -->
    <div class="card mb-4">
      <div class="card-header">Documento</div>
      <div class="card-body text-muted">
        Próximamente
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
