<div class="modal fade" id="modalEditarReunion" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">Editar Reunión Prebautismal</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/web/tramites/<%= tramite.id %>/reunion" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Catequista</label>
            <select name="id_fk_persona_catequista" class="form-select">
              <option value="">-- Seleccionar --</option>
              <% ListaDecatequistas.forEach(function(c) { %>
                <option value="<%= c.id %>" <%= reunion && reunion.id_fk_persona_catequista === c.id ? 'selected' : '' %>>
                  <%= c.nombre %> <%= c.apellido %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Fecha reunión</label>
            <input type="date" name="fecha" class="form-control"
              value="<%= reunion && reunion.fecha ? new Date(reunion.fecha).toISOString().split('T')[0] : '' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-select" required>
              <% estadosReunion.forEach(function(e) { %>
                <option value="<%= e %>" <%= reunion && reunion.estado === e ? 'selected' : '' %>><%= e %></option>
              <% }); %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>
