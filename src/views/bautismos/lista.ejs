<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Trámites de Bautismo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/web">Parroquia &mdash; Bautismos</a>
      <div class="d-flex gap-2">
        <a href="/web" class="btn btn-outline-light btn-sm">Trámites</a>
        <a href="/web/personas" class="btn btn-outline-light btn-sm">Personas</a>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="mb-0">Trámites de Bautismo</h2>
      <form action="/web/tramites" method="POST">
        <button class="btn btn-success">+ Nuevo Trámite</button>
      </form>
    </div>
    <table class="table" id="tablaTramites">
      <thead>
        <tr>
          <th>ID</th>
          <th>Bautizado</th>
          <th>Fecha ingreso</th>
          <th>Estado</th>
          <th>Fecha bautismo</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% tramites.forEach(function(item){ %>
          <% const bautizado = item.participacion && item.participacion[0] ? item.participacion[0].Persona : null; %>
          <tr>
              <td><%= item.id %></td>
              <td><%= bautizado ? bautizado.nombre + ' ' + bautizado.apellido : '—' %></td>
              <td><%= item.fecha_ingreso ? new Date(item.fecha_ingreso).toLocaleDateString('es-CL') : '—' %></td>
              <td><%= item.estado %></td>
              <td><%= item.fecha_bautismo ? new Date(item.fecha_bautismo).toLocaleDateString('es-CL'): '—' %></td>
              <td class="d-flex gap-1">
                <a href="/web/tramites/<%= item.id %>" class="btn btn-primary btn-sm">Ver</a>
                <% if (bautizado) { %>
                  <a href="/web/personas?edit=<%= bautizado.id %>" class="btn btn-outline-secondary btn-sm">Editar persona</a>
                <% } %>
              </td>
          </tr>
       <% }); %>

      </tbody>
    </table>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/lista.js"></script>
</body>
</html>
