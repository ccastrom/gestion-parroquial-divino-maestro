<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Trámites de Bautismo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <%- include('../partials/navbar', { paginaActual: 'tramites' }) %>

  <div class="container py-4">

    <% if (locals.query && query.success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= decodeURIComponent(query.success) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="mb-0">Trámites de Bautismo</h2>
      <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalRegistrarHistorico">Registrar histórico</button>
        <form action="/web/tramites" method="POST">
          <button class="btn btn-success">+ Nuevo Trámite</button>
        </form>
      </div>
    </div>
    <table class="table" id="tablaTramites">
      <thead>
        <tr>
          <th>ID</th>
          <th>Bautizado</th>
          <th>Fecha ingreso</th>
          <th>Estado</th>
          <th>Fecha bautismo</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% tramites.forEach(function(item){ %>
          <% const bautizado = item.participacion && item.participacion[0] ? item.participacion[0].Persona : null; %>
          <%
            var _fbIso = item.fecha_bautismo ? new Date(item.fecha_bautismo).toISOString() : null;
            var _fbFecha = _fbIso ? _fbIso.split('T')[0].split('-').reverse().join('-') : '—';
            var _fbHora  = _fbIso ? _fbIso.split('T')[1].substring(0,5) : null;
            if (_fbHora === '00:00') _fbHora = null;
          %>
          <tr>
              <td><%= item.id %></td>
              <td><%= bautizado ? bautizado.nombre + ' ' + bautizado.apellido : '—' %></td>
              <td><%= item.fecha_ingreso ? item.fecha_ingreso.split('-').reverse().join('-') : '—' %></td>
              <td><%= item.estado %></td>
              <td><%= _fbFecha %><% if (_fbHora) { %> <small class="text-muted"><%= _fbHora %>h</small><% } %></td>
              <td class="d-flex gap-1">
                <a href="/web/tramites/<%= item.id %>" class="btn btn-primary btn-sm">Ver</a>
                <% if (bautizado) { %>
                  <a href="/web/personas?edit=<%= bautizado.id %>" class="btn btn-outline-secondary btn-sm">Editar persona</a>
                <% } %>
                <button type="button" class="btn btn-outline-danger btn-sm"
                  data-bs-toggle="modal" data-bs-target="#modalConfirmarEliminar"
                  data-id="<%= item.id %>">Eliminar</button>
              </td>
          </tr>
       <% }); %>

      </tbody>
    </table>
    <!-- Archivados -->
    <% if (tramitesEliminados && tramitesEliminados.length > 0) { %>
      <div class="mt-4">
        <button class="btn btn-outline-secondary btn-sm mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#tablaArchivados">
          Archivados <span class="badge bg-secondary ms-1"><%= tramitesEliminados.length %></span>
        </button>
        <div class="collapse" id="tablaArchivados">
          <div class="card">
            <div class="card-header bg-secondary text-white fw-semibold">Trámites archivados</div>
            <div class="card-body p-0">
              <table class="table table-hover mb-0" id="tablaArchivadosData">
                <thead class="table-light">
                  <tr>
                    <th>ID</th>
                    <th>Bautizado</th>
                    <th>Estado</th>
                    <th>Eliminado</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% tramitesEliminados.forEach(function(item) { %>
                    <% var bautizado = item.participacion && item.participacion[0] ? item.participacion[0].Persona : null; %>
                    <% var fechaElim = new Date(item.fecha_eliminacion).toISOString().split('T')[0].split('-').reverse().join('-'); %>
                    <tr class="text-muted">
                      <td><%= item.id %></td>
                      <td><%= bautizado ? bautizado.nombre + ' ' + bautizado.apellido : '—' %></td>
                      <td><%= item.estado || '—' %></td>
                      <td><small><%= fechaElim %></small></td>
                      <td>
                        <form action="/web/tramites/<%= item.id %>/restaurar" method="POST" style="display:inline">
                          <button type="submit" class="btn btn-outline-success btn-sm">Restaurar</button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Históricos -->
    <% if (tramitesHistoricos && tramitesHistoricos.length > 0) { %>
      <div class="mt-4">
        <button class="btn btn-outline-dark btn-sm mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#tablaHistoricos">
          Registros históricos <span class="badge bg-dark ms-1"><%= tramitesHistoricos.length %></span>
        </button>
        <div class="collapse" id="tablaHistoricos">
          <div class="card">
            <div class="card-header bg-dark text-white fw-semibold">Bautismos históricos</div>
            <div class="card-body p-0">
              <table class="table table-hover mb-0" id="tablaHistoricosData">
                <thead class="table-light">
                  <tr>
                    <th>#</th>
                    <th>Bautizado</th>
                    <th>Ingreso</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% tramitesHistoricos.forEach(function(item) { %>
                    <% var bautizado = item.participacion && item.participacion[0] ? item.participacion[0].Persona : null; %>
                    <tr>
                      <td><%= item.id %></td>
                      <td><%= bautizado ? bautizado.nombre + ' ' + bautizado.apellido : '—' %></td>
                      <td><small><%= item.fecha_ingreso ? item.fecha_ingreso.split('-').reverse().join('-') : '—' %></small></td>
                      <td><a href="/web/tramites/<%= item.id %>" class="btn btn-outline-secondary btn-sm">Ver</a></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    <% } %>

  </div>

  <!-- Modal confirmar eliminar -->
  <div class="modal fade" id="modalConfirmarEliminar" tabindex="-1">
    <div class="modal-dialog modal-sm">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title">¿Archivar trámite?</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="mb-0 small">El trámite quedará archivado y podrá restaurarse desde la sección Archivados.</p>
        </div>
        <div class="modal-footer py-2">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
          <form id="formConfirmarEliminar" method="POST" style="display:inline">
            <input type="hidden" name="origen" value="lista">
            <button type="submit" class="btn btn-danger btn-sm">Sí, archivar</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal registrar histórico -->
  <div class="modal fade" id="modalRegistrarHistorico" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-dark text-white">
          <h5 class="modal-title">Registrar bautismo histórico</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form action="/web/tramites/historico" method="POST" novalidate id="formHistorico">
          <div class="modal-body">

            <!-- Bautizado -->
            <h6 class="fw-bold border-bottom pb-1 mb-3">Bautizado</h6>
            <div class="row g-2 mb-2">
              <div class="col-md-6">
                <label class="form-label">Nombre *</label>
                <input type="text" name="bautizado_nombre" id="bautizado_nombre" class="form-control">
                <div class="invalid-feedback">El nombre es obligatorio</div>
              </div>
              <div class="col-md-6">
                <label class="form-label">Apellido *</label>
                <input type="text" name="bautizado_apellido" id="bautizado_apellido" class="form-control">
                <div class="invalid-feedback">El apellido es obligatorio</div>
              </div>
            </div>
            <div class="row g-2 mb-2">
              <div class="col-md-4">
                <label class="form-label">RUT</label>
                <input type="text" name="bautizado_rut" class="form-control">
              </div>
              <div class="col-md-4">
                <label class="form-label">Fecha de nacimiento</label>
                <input type="date" name="bautizado_fecha_nacimiento" class="form-control">
              </div>
              <div class="col-md-4">
                <label class="form-label">Lugar de nacimiento</label>
                <input type="text" name="bautizado_lugar_nacimiento" class="form-control">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Dirección</label>
              <input type="text" name="bautizado_direccion" class="form-control">
            </div>

            <!-- Padre -->
            <h6 class="fw-bold border-bottom pb-1 mb-3 mt-4">Padre</h6>
            <div class="row g-2 mb-3">
              <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input type="text" name="padre_nombre" class="form-control">
              </div>
              <div class="col-md-6">
                <label class="form-label">Apellido</label>
                <input type="text" name="padre_apellido" class="form-control">
              </div>
            </div>

            <!-- Madre -->
            <h6 class="fw-bold border-bottom pb-1 mb-3 mt-2">Madre</h6>
            <div class="row g-2 mb-3">
              <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input type="text" name="madre_nombre" class="form-control">
              </div>
              <div class="col-md-6">
                <label class="form-label">Apellido</label>
                <input type="text" name="madre_apellido" class="form-control">
              </div>
            </div>

            <!-- Padrino/Madrina (cantidad variable) -->
            <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-3 mt-4">
              <h6 class="fw-bold mb-0">Padrino/Madrina</h6>
              <button type="button" class="btn btn-outline-secondary btn-sm" id="btnAgregarPadrino">+ Agregar</button>
            </div>
            <div id="contenedorFilasPadrino">
              <div class="row g-2 mb-2 fila-padrino">
                <div class="col-md-5">
                  <input type="text" name="padrino_nombre" class="form-control" placeholder="Nombre">
                </div>
                <div class="col-md-5">
                  <input type="text" name="padrino_apellido" class="form-control" placeholder="Apellido">
                </div>
                <div class="col-md-2 d-flex align-items-center">
                  <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar-fila-padrino">×</button>
                </div>
              </div>
            </div>

          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-dark">Guardar registro</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/lista.js"></script>
</body>
</html>
