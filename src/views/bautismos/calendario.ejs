<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Calendario — Bautismos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet">
  <style>
    .fc-event { cursor: pointer; }
    .fc { font-size: 0.85rem; }
    .fc-dia-pasado { opacity: 0.4; cursor: not-allowed; }
  </style>
</head>
<body class="bg-light">

  <%- include('../partials/navbar', { paginaActual: 'calendario' }) %>

  <%
    // ── helpers ─────────────────────────────────────────────────────────────

    var COLORES = {
      'Bautizo finalizado con éxito':          '#198754',
      'Evento bautizo agendado':               '#0d6efd',
      'Bautizo reabierto':                     '#ffc107',
      'Bautizo derivado a otra parroquia':     '#6f42c1',
      'Bautizo cancelado':                     '#dc3545',
    };

    function getBautizado(t) {
      return t.participacion && t.participacion[0] && t.participacion[0].Persona || null;
    }

    function getColor(t) {
      if (!getBautizado(t)) return '#6c757d';          // gris — reserva sin bautizado
      return COLORES[t.estado] || '#fd7e14';            // naranja — en proceso
    }

    var eventosCalendario = eventos.map(function(t) {
      var p = getBautizado(t);
      return {
        id:              t.id,
        title:           p ? p.nombre + ' ' + p.apellido : 'Reserva sin confirmar',
        start:           t.fecha_bautismo,
        url:             '/web/tramites/' + t.id,
        backgroundColor: getColor(t),
        borderColor:     getColor(t),
        extendedProps:   {
          estado: t.estado,
          hora: (function() {
            if (!t.fecha_bautismo) return null;
            var h = new Date(t.fecha_bautismo).toISOString().split('T')[1].substring(0,5);
            return h === '00:00' ? null : h;
          })()
        }
      };
    });
  %>

  <div class="container py-4">

    <% if (locals.query && query.error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= decodeURIComponent(query.error) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Calendario -->
    <div class="card mb-4">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Calendario de Bautismos</span>
        <input type="text" id="buscarBautizado" class="form-control form-control-sm ms-3" style="max-width:220px" placeholder="Buscar bautizado...">
      </div>
      <div class="card-body">
        <div class="d-flex flex-wrap gap-3 mb-3 small text-muted">
          <span><span class="badge" style="background:#6c757d">&nbsp;</span> Reserva sin confirmar</span>
          <span><span class="badge" style="background:#fd7e14">&nbsp;</span> En proceso</span>
          <span><span class="badge" style="background:#0d6efd">&nbsp;</span> Agendado</span>
          <span><span class="badge" style="background:#ffc107">&nbsp;</span> Reabierto</span>
          <span><span class="badge" style="background:#198754">&nbsp;</span> Finalizado</span>
          <span><span class="badge" style="background:#6f42c1">&nbsp;</span> Derivado</span>
          <span><span class="badge" style="background:#dc3545">&nbsp;</span> Cancelado</span>
        </div>
        <div id="calendario"></div>
      </div>
    </div>

    <!-- Trámites sin fecha -->
    <div class="card">
      <div class="card-header bg-secondary text-white fw-semibold">
        Trámites sin fecha de bautismo
        <span class="badge bg-light text-dark ms-2"><%= sinFecha.length %></span>
      </div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>Bautizado</th>
              <th>Estado</th>
              <th>Ingreso</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (sinFecha.length > 0) { %>
              <% sinFecha.forEach(function(t) { %>
                <% var p = getBautizado(t); %>
                <tr>
                  <td><%= t.id %></td>
                  <td>
                    <% if (p) { %>
                      <%= p.nombre %> <%= p.apellido %>
                    <% } else { %>
                      <span class="text-muted fst-italic">Sin bautizado</span>
                    <% } %>
                  </td>
                  <td><span class="badge bg-secondary"><%= t.estado %></span></td>
                  <td><%= t.fecha_ingreso ? t.fecha_ingreso.split('-').reverse().join('-') : '—' %></td>
                  <td><a href="/web/tramites/<%= t.id %>" class="btn btn-outline-secondary btn-sm">Ver</a></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="5" class="text-center text-muted py-3">Todos los trámites tienen fecha asignada</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Modal reservar fecha -->
  <div class="modal fade" id="modalNuevoTramite" tabindex="-1">
    <div class="modal-dialog modal-sm">
      <div class="modal-content">
        <div class="modal-header bg-success text-white">
          <h6 class="modal-title mb-0">Reservar bautismo</h6>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form action="/web/tramites" method="POST">
          <input type="hidden" name="origen" value="calendario">
          <input type="hidden" id="nuevaFecha" name="fecha_bautismo">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label small fw-semibold text-muted">Fecha seleccionada</label>
              <p id="nuevaFechaTexto" class="mb-0 fw-semibold">—</p>
            </div>
            <div class="mb-2">
              <label class="form-label small fw-semibold">Hora <span class="text-muted fw-normal">(opcional)</span></label>
              <input type="time" id="nuevaHora" name="hora_bautismo" class="form-control form-control-sm">
            </div>
          </div>
          <div class="modal-footer py-2">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-success btn-sm">Reservar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
  <script>
    var todosLosEventos = <%- JSON.stringify(eventosCalendario) %>;
  </script>
  <script src="/js/calendario.js"></script>
</body>
</html>
