<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registro histórico #<%= tramite.id %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/ficha-bautismo.css">
  <link rel="stylesheet" href="/css/print.css">
</head>
<body class="bg-light">

  <%- include('../partials/navbar', { paginaActual: 'tramites' }) %>

  <div class="container py-4">

    <% if (locals.query && query.error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= decodeURIComponent(query.error) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <a href="/web" class="text-muted text-decoration-none small">← Volver a la lista</a>
        <h2 class="mb-0 mt-1">Registro histórico <span class="text-muted">#<%= tramite.id %></span></h2>
      </div>
      <button class="btn btn-outline-secondary" onclick="window.print()">Imprimir ficha</button>
    </div>

    <%
      const bautizado = ListaDeParticipantes.find(participante => participante.rol === 'Bautizado');
      const padre     = ListaDeParticipantes.find(participante => participante.rol === 'Padre' || participante.rol === 'Padre 2');
      const madre     = ListaDeParticipantes.find(participante => participante.rol === 'Madre' || participante.rol === 'Madre 2');
      const padrinos  = ListaDeParticipantes.filter(participante => participante.rol === 'Padrino' || participante.rol === 'Madrina');

      const formatFecha = (val) => {
        if (!val) return '—';
        const iso = (typeof val === 'string' && val.length === 10) ? val : new Date(val).toISOString().split('T')[0];
        return iso.split('-').reverse().join('-');
      };
    %>

    <div class="row g-4">

      <!-- Bautizado -->
      <div class="col-12">
        <div class="card shadow-sm">
          <div class="card-header fw-semibold">Bautizado</div>
          <div class="card-body">
            <% if (bautizado) { %>
              <div class="row g-3">
                <div class="col-md-6">
                  <small class="text-muted d-block">Nombre completo</small>
                  <span class="fw-semibold"><%= bautizado.Persona.nombre %> <%= bautizado.Persona.apellido %></span>
                </div>
                <% if (bautizado.Persona.rut) { %>
                  <div class="col-md-3">
                    <small class="text-muted d-block">RUT</small>
                    <span><%= bautizado.Persona.rut %></span>
                  </div>
                <% } %>
                <% if (bautizado.Persona.fecha_nacimiento) { %>
                  <div class="col-md-3">
                    <small class="text-muted d-block">Fecha de nacimiento</small>
                    <span><%= formatFecha(bautizado.Persona.fecha_nacimiento) %></span>
                  </div>
                <% } %>
                <% if (bautizado.Persona.lugar_nacimiento) { %>
                  <div class="col-md-6">
                    <small class="text-muted d-block">Lugar de nacimiento</small>
                    <span><%= bautizado.Persona.lugar_nacimiento %></span>
                  </div>
                <% } %>
                <% if (bautizado.Persona.direccion) { %>
                  <div class="col-md-6">
                    <small class="text-muted d-block">Dirección</small>
                    <span><%= bautizado.Persona.direccion %></span>
                  </div>
                <% } %>
              </div>
            <% } else { %>
              <p class="text-muted mb-0">Sin bautizado registrado</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Familia y padrinos -->
      <div class="col-12">
        <div class="card shadow-sm">
          <div class="card-header fw-semibold">Familia y padrinos</div>
          <div class="card-body p-0">
            <table class="table mb-0">
              <thead class="table-light">
                <tr>
                  <th>Rol</th>
                  <th>Nombre</th>
                </tr>
              </thead>
              <tbody>
                <% if (padre) { %>
                  <tr>
                    <td><span class="badge bg-secondary">Padre</span></td>
                    <td><%= padre.Persona.nombre %> <%= padre.Persona.apellido %></td>
                  </tr>
                <% } %>
                <% if (madre) { %>
                  <tr>
                    <td><span class="badge bg-secondary">Madre</span></td>
                    <td><%= madre.Persona.nombre %> <%= madre.Persona.apellido %></td>
                  </tr>
                <% } %>
                <% padrinos.forEach(function(padrino) { %>
                  <tr>
                    <td><span class="badge bg-secondary">Padrino/Madrina</span></td>
                    <td><%= padrino.Persona.nombre %> <%= padrino.Persona.apellido %></td>
                  </tr>
                <% }); %>
                <% if (!padre && !madre && padrinos.length === 0) { %>
                  <tr><td colspan="2" class="text-muted">Sin participantes registrados</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>

  <%- include('ficha') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
