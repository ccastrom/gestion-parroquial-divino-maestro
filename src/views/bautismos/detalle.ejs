<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Trámite #<%= tramite.id %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/print.css" rel="stylesheet">
  <link href="/css/ficha-bautismo.css" rel="stylesheet">
</head>
<body class="bg-light">
<%
  function isoHora(val) {
    if (!val) return null;
    var t = new Date(val).toISOString().split('T')[1].substring(0, 5);
    return t === '00:00' ? null : t;
  }
%>

  <%- include('../partials/navbar', { paginaActual: 'tramites' }) %>

  <div class="container py-4">

    <% if (locals.query && query.error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= decodeURIComponent(query.error) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (locals.query && query.success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= decodeURIComponent(query.success) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Encabezado -->
    <div class="d-flex align-items-center gap-3 mb-4">
      <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm no-print">← Volver</a>
      <h2 class="mb-0">Trámite #<%= tramite.id %></h2>
      <span class="badge bg-secondary fs-6"><%= tramite.estado || 'Sin estado' %></span>
      <button onclick="window.print()" class="btn btn-outline-dark btn-sm ms-auto no-print">Imprimir ficha</button>
    </div>

    <!-- Datos del trámite -->
    <div class="card mb-4">
      <div class="card-header bg-primary text-white">Información del Trámite</div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-4">
            <small class="text-muted">Fecha ingreso</small>
            <p><%= tramite.fecha_ingreso ? tramite.fecha_ingreso.split('-').reverse().join('-') : '—' %></p>
          </div>
          <div class="col-md-4">
            <small class="text-muted">Fecha bautismo</small>
            <p>
              <%= tramite.fecha_bautismo ? new Date(tramite.fecha_bautismo).toISOString().split('T')[0].split('-').reverse().join('-') : '—' %>
              <% if (isoHora(tramite.fecha_bautismo)) { %><span class="text-muted ms-1"><%= isoHora(tramite.fecha_bautismo) %>h</span><% } %>
            </p>
          </div>
          <div class="col-md-4">
            <small class="text-muted">Estado</small>
            <p><%= tramite.estado || '—' %></p>
          </div>
        </div>
        <div class="mt-3 no-print">
          <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalEditarEstado">Editar Estado</button>
        </div>
      </div>
    </div>

    <!-- Modal Editar Estado -->
    <div class="modal fade" id="modalEditarEstado" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title">Editar Estado del Trámite</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <form action="/web/tramites/<%= tramite.id %>/estado" method="POST">
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-select" required>
                  <% estadosTramite.forEach(function(e) { %>
                    <option value="<%= e %>" <%= tramite.estado === e ? 'selected' : '' %>><%= e %></option>
                  <% }); %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label">Fecha bautismo</label>
                <input type="date" name="fecha_bautismo" class="form-control" value="<%= tramite.fecha_bautismo ? new Date(tramite.fecha_bautismo).toISOString().split('T')[0] : '' %>">
              </div>
              <div class="mb-3">
                <label class="form-label">Hora bautismo</label>
                <input type="time" name="hora_bautismo" class="form-control" value="<%= isoHora(tramite.fecha_bautismo) || '' %>">
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Participantes -->
    <div class="card mb-4">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        Participantes
        <button class="btn btn-light btn-sm no-print" data-bs-toggle="modal" data-bs-target="#modalAgregarParticipante">+ Agregar</button>
      </div>
      <div class="card-body">
        <% if (participantes && participantes.length > 0) { %>
          <% const rolesEdicion = ['Bautizado', 'Padre', 'Madre', 'Padre 2', 'Madre 2', 'Padrino', 'Madrina', 'Celebrante', 'Tutor Legal', 'Testigo']; %>
          <% participantes.forEach(function(p) { %>
            <div class="mb-3 p-3 border rounded">
              <div class="row">
                <div class="col-md-4">
                  <small class="text-muted">Rol</small>
                  <p><strong><%= p.rol %></strong></p>
                </div>
                <div class="col-md-4">
                  <small class="text-muted">Nombre</small>
                  <p><%= p.Persona.nombre %> <%= p.Persona.apellido %></p>
                </div>
                <div class="col-md-3">
                  <small class="text-muted">RUT</small>
                  <p><%= p.Persona.rut || '—' %></p>
                </div>
                <div class="col-md-1 d-flex align-items-center no-print">
                  <button class="btn btn-warning btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#modalEditarRol-<%= p.id %>">
                    Editar rol
                  </button>
                </div>
              </div>
            </div>

            <!-- Modal Editar Rol -->
            <div class="modal fade" id="modalEditarRol-<%= p.id %>" tabindex="-1">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Editar Rol — <%= p.Persona.nombre %> <%= p.Persona.apellido %></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                  </div>
                  <form action="/web/tramites/<%= tramite.id %>/participacion/<%= p.id %>/rol" method="POST">
                    <div class="modal-body">
                      <div class="mb-3">
                        <label class="form-label">Rol</label>
                        <select name="rol" class="form-select" required>
                          <% rolesEdicion.forEach(function(r) { %>
                            <option value="<%= r %>" <%= p.rol === r ? 'selected' : '' %>><%= r %></option>
                          <% }); %>
                        </select>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                      <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p class="text-muted">Sin participantes agregados</p>
        <% } %>
      </div>
    </div>

    <!-- Reunión Prebautismal -->
    <div class="card mb-4">
      <div class="card-header bg-primary text-white">Reunión Prebautismal</div>
      <div class="card-body">
        <% if (reunion) { %>
          <div class="row">
            <div class="col-md-4">
              <small class="text-muted">Estado</small>
              <p><%= reunion.estado || '—' %></p>
            </div>
             <div class="col-md-4">
              <small class="text-muted">Catequista asignado</small>
              <p><%= catequista ? `${catequista.nombre} ${catequista.apellido}` : '—' %></p>
            </div>
            <div class="col-md-4">
              <small class="text-muted">Fecha reunión</small>
              <p><%= reunion.fecha ? new Date(reunion.fecha).toISOString().split('T')[0].split('-').reverse().join('-') : '—' %></p>
            </div>
           
          </div>
          <div class="mt-3 d-flex gap-2 no-print">
            <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalEditarReunion">Editar Reunión</button>
            <form action="/web/tramites/<%= tramite.id %>/completar-reunion" method="POST"
              onsubmit="return confirm('¿Confirmas que la reunión fue completada? Esta acción no se puede deshacer.')">
              <button type="submit" class="btn btn-success btn-sm">Marcar como completada</button>
            </form>
          </div>
        <% } else { %>
          <p class="text-muted">Sin reunión prebautismal registrada</p>
        <% } %>
      </div>
    </div>

    <!-- Modal Editar Reunión -->
    <div class="modal fade" id="modalEditarReunion" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title">Editar Reunión Prebautismal</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <form action="/web/tramites/<%= tramite.id %>/reunion" method="POST">
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label">Catequista</label>
                <select name="id_fk_persona_catequista" class="form-select">
                  <option value="">-- Seleccionar --</option>
                  <% ListaDecatequistas.forEach(function(c) { %>
                    <option value="<%= c.id %>" <%= reunion && reunion.id_fk_persona_catequista === c.id ? 'selected' : '' %>>
                      <%= c.nombre %> <%= c.apellido %>
                    </option>
                  <% }); %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label">Fecha reunión</label>
                <input type="date" name="fecha" class="form-control"
                  value="<%= reunion && reunion.fecha ? new Date(reunion.fecha).toISOString().split('T')[0] : '' %>">
              </div>
              <div class="mb-3">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-select" required>
                  <% estadosReunion.forEach(function(e) { %>
                    <option value="<%= e %>" <%= reunion && reunion.estado === e ? 'selected' : '' %>><%= e %></option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Documentos -->
    <div class="card mb-4">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        Documentos
        <button class="btn btn-light btn-sm no-print" data-bs-toggle="modal" data-bs-target="#modalAgregarDocumento">+ Agregar</button>
      </div>
      <div class="card-body">
        <%
          const tieneDocumentos = participantes && participantes.some(p => p.documento);
        %>
        <% if (tieneDocumentos) { %>
          <% participantes.forEach(function(p) { %>
            <% if (p.documento) { %>
              <div class="mb-3 p-3 border rounded">
                <div class="row">
                  <div class="col-md-3">
                    <small class="text-muted">Participante</small>
                    <p><strong><%= p.Persona.nombre %> <%= p.Persona.apellido %></strong></p>
                  </div>
                  <div class="col-md-3">
                    <small class="text-muted">Tipo de documento</small>
                    <p><%= p.documento.tipo_documento %></p>
                  </div>
                  <div class="col-md-3">
                    <small class="text-muted">Estado</small>
                    <p><%= p.documento.estado_documento %></p>
                  </div>
                  <div class="col-md-2">
                    <small class="text-muted">Fecha entrega</small>
                    <p><%= p.documento.fecha_entrega ? new Date(p.documento.fecha_entrega).toISOString().split('T')[0].split('-').reverse().join('-') : '—' %></p>
                  </div>
                  <div class="col-md-1 d-flex align-items-center no-print">
                    <button class="btn btn-warning btn-sm"
                      data-bs-toggle="modal"
                      data-bs-target="#modalEditarDocumento-<%= p.documento.id %>">
                      Editar
                    </button>
                  </div>
                </div>
              </div>

              <!-- Modal Editar Documento -->
              <div class="modal fade" id="modalEditarDocumento-<%= p.documento.id %>" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                      <h5 class="modal-title">Editar Documento — <%= p.Persona.nombre %> <%= p.Persona.apellido %></h5>
                      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/web/tramites/<%= tramite.id %>/documento/<%= p.documento.id %>" method="POST">
                      <div class="modal-body">
                        <div class="mb-3">
                          <label class="form-label">Tipo de documento</label>
                          <input type="text" name="tipo_documento" class="form-control" value="<%= p.documento.tipo_documento || '' %>">
                        </div>
                        <div class="mb-3">
                          <label class="form-label">Estado</label>
                          <select name="estado_documento" class="form-select" required>
                            <% estadosDocumento.forEach(function(e) { %>
                              <option value="<%= e %>" <%= p.documento.estado_documento === e ? 'selected' : '' %>><%= e %></option>
                            <% }); %>
                          </select>
                        </div>
                        <div class="mb-3">
                          <label class="form-label">Fecha entrega</label>
                          <input type="date" name="fecha_entrega" class="form-control" value="<%= p.documento.fecha_entrega || '' %>">
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            <% } %>
          <% }); %>
        <% } else { %>
          <p class="text-muted">Sin documentos registrados</p>
        <% } %>
      </div>
    </div>

  </div>

    <!-- Modal Agregar Documento -->
    <div class="modal fade" id="modalAgregarDocumento" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title">Agregar Documento</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <form action="/web/tramites/<%= tramite.id %>/documento" method="POST">
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label">Participante</label>
                <select name="id_participacion" class="form-select" required>
                  <option value="">-- Seleccionar --</option>
                  <% const rolesDocumento = ['Bautizado', 'Padrino', 'Madrina']; %>
                  <% participantes.filter(p => rolesDocumento.includes(p.rol)).forEach(function(p) { %>
                    <option value="<%= p.id %>"><%= p.rol %> — <%= p.Persona.nombre %> <%= p.Persona.apellido %></option>
                  <% }); %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label">Tipo de documento</label>
                <input type="text" name="tipo_documento" class="form-control" placeholder="Ej: Partida de nacimiento">
              </div>
              <div class="mb-3">
                <label class="form-label">Estado</label>
                <select name="estado_documento" class="form-select" required>
                  <% estadosDocumento.forEach(function(e) { %>
                    <option value="<%= e %>"><%= e %></option>
                  <% }); %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label">Fecha entrega</label>
                <input type="date" name="fecha_entrega" class="form-control">
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Modal Agregar Participante -->
    <%
      const rolesUnicos       = ['Bautizado', 'Padre', 'Madre', 'Padre 2', 'Madre 2', 'Celebrante'];
      const rolesTabNuevo     = ['Bautizado', 'Padre', 'Madre', 'Padre 2', 'Madre 2', 'Padrino', 'Madrina', 'Tutor Legal', 'Testigo'];
      const rolesTabExistente = ['Bautizado', 'Padre', 'Madre', 'Padre 2', 'Madre 2', 'Padrino', 'Madrina', 'Celebrante', 'Tutor Legal', 'Testigo'];

      const rolesTomados = participantes.map(function(p) { return p.rol; });
      const rolesDisponiblesNuevo     = rolesTabNuevo.filter(function(r) { return !rolesUnicos.includes(r) || !rolesTomados.includes(r); });
      const rolesDisponiblesExistente = rolesTabExistente.filter(function(r) { return !rolesUnicos.includes(r) || !rolesTomados.includes(r); });
    %>
    <div class="modal fade" id="modalAgregarParticipante" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title">Agregar Participante</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">

            <!-- Pestañas -->
            <ul class="nav nav-tabs mb-3" id="tabsParticipante">
              <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabNuevo">Nueva persona</button>
              </li>
              <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabExistente">Persona existente</button>
              </li>
            </ul>

            <div class="tab-content">

              <!-- Pestaña 1: Nueva persona -->
              <div class="tab-pane fade show active" id="tabNuevo">
                <form id="formNuevoParticipante" action="/web/tramites/<%= tramite.id %>/participantes" method="POST" novalidate>
                  <div class="mb-3">
                    <label class="form-label">Rol</label>
                    <select name="rol" id="rolNuevo" class="form-select">
                      <option value="">-- Seleccionar --</option>
                      <% rolesDisponiblesNuevo.forEach(function(r) { %>
                        <option value="<%= r %>"><%= r %></option>
                      <% }); %>
                    </select>
                    <div class="invalid-feedback">Selecciona un rol</div>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text" name="nombre" id="nombreNuevo" class="form-control">
                    <div class="invalid-feedback">El nombre es obligatorio</div>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Apellido</label>
                    <input type="text" name="apellido" id="apellidoNuevo" class="form-control">
                    <div class="invalid-feedback">El apellido es obligatorio</div>
                  </div>
                  <div class="mb-3">
                    <label id="labelRutNuevo" class="form-label">RUT</label>
                    <input type="text" name="rut" id="rutNuevo" class="form-control">
                    <div class="invalid-feedback">El RUT es obligatorio para el Bautizado</div>
                  </div>
                  <div class="mb-3">
                    <label id="labelFechaNuevo" class="form-label">Fecha de nacimiento</label>
                    <input type="date" name="fecha_nacimiento" id="fechaNacimientoNuevo" class="form-control">
                    <div class="invalid-feedback">La fecha de nacimiento es obligatoria para el Bautizado</div>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Teléfono</label>
                    <input type="text" name="fono" class="form-control">
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Dirección</label>
                    <input type="text" name="direccion" class="form-control">
                  </div>
                  <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                  </div>
                </form>
              </div>

              <!-- Pestaña 2: Persona existente -->
              <div class="tab-pane fade" id="tabExistente">
                <form action="/web/tramites/<%= tramite.id %>/participantes" method="POST">
                  <div class="mb-3">
                    <label class="form-label">Rol</label>
                    <select name="rol" id="rolExistente" class="form-select" required>
                      <option value="">-- Seleccionar --</option>
                      <% rolesDisponiblesExistente.forEach(function(r) { %>
                        <option value="<%= r %>"><%= r %></option>
                      <% }); %>
                    </select>
                  </div>
                  <div class="mb-3" id="wrapperFamiliares">
                    <label class="form-label">Persona</label>
                    <select name="personaId" id="selectFamiliares" class="form-select" required>
                      <option value="">-- Seleccionar --</option>
                      <% ListaDePersonas.forEach(function(persona) { %>
                        <option value="<%= persona.id %>"><%= persona.apellido %>, <%= persona.nombre %></option>
                      <% }); %>
                    </select>
                  </div>
                  <div class="mb-3 d-none" id="wrapperCelebrantes">
                    <label class="form-label">Celebrante</label>
                    <select name="personaId" id="selectCelebrantes" class="form-select" disabled>
                      <option value="">-- Seleccionar --</option>
                      <% ListaDeCelebrantes.forEach(function(c) { %>
                        <option value="<%= c.id %>"><%= c.apellido %>, <%= c.nombre %></option>
                      <% }); %>
                    </select>
                  </div>
                  <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                  </div>
                </form>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>

  <%- include('ficha') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/detalle.js"></script>
</body>
</html>
