<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Trámite #<%= tramite.id %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/web">Parroquia &mdash; Bautismos</a>
    </div>
  </nav>

  <div class="container py-4">

    <% if (locals.query && query.error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= decodeURIComponent(query.error) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (locals.query && query.success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= decodeURIComponent(query.success) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Encabezado -->
    <div class="d-flex align-items-center gap-3 mb-4">
      <a href="/web" class="btn btn-outline-secondary btn-sm">← Volver</a>
      <h2 class="mb-0">Trámite #<%= tramite.id %></h2>
      <span class="badge bg-secondary fs-6"><%= tramite.estado || 'Sin estado' %></span>
    </div>

    <!-- Datos del trámite -->
    <div class="card mb-4">
      <div class="card-header bg-primary text-white">Información del Trámite</div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-4">
            <small class="text-muted">Fecha ingreso</small>
            <p><%= tramite.fecha_ingreso ? new Date(tramite.fecha_ingreso).toLocaleDateString('es-CL') : '—' %></p>
          </div>
          <div class="col-md-4">
            <small class="text-muted">Fecha bautismo</small>
            <p><%= tramite.fecha_bautismo ? new Date(tramite.fecha_bautismo).toLocaleDateString('es-CL') : '—' %>
</p>
          </div>
          <div class="col-md-4">
            <small class="text-muted">Estado</small>
            <p><%= tramite.estado || '—' %></p>
          </div>
        </div>
        <div class="mt-3">
          <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalEditarEstado">Editar Estado</button>
        </div>
      </div>
    </div>

    <!-- Modal Editar Estado -->
    <div class="modal fade" id="modalEditarEstado" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title">Editar Estado del Trámite</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <form action="/web/tramites/<%= tramite.id %>/estado" method="POST">
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-select" required>
                  <% estados.forEach(function(e) { %>
                    <option value="<%= e %>" <%= tramite.estado === e ? 'selected' : '' %>><%= e %></option>
                  <% }); %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label">Fecha bautismo</label>
                <input type="date" name="fecha_bautismo" class="form-control" value="<%= tramite.fecha_bautismo || '' %>">
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Participantes -->
    <div class="card mb-4">
      <div class="card-header bg-primary text-white">Participantes</div>
      <div class="card-body">
        <% if (participantes && participantes.length > 0) { %>
          <% participantes.forEach(function(p) { %>
            <div class="mb-3 p-3 border rounded">
              <div class="row">
                <div class="col-md-4">
                  <small class="text-muted">Rol</small>
                  <p><strong><%= p.rol %></strong></p>
                </div>
                <div class="col-md-4">
                  <small class="text-muted">Nombre</small>
                  <p><%= p.Persona.nombre %> <%= p.Persona.apellido %></p>
                </div>
                <div class="col-md-4">
                  <small class="text-muted">RUT</small>
                  <p><%= p.Persona.rut || '—' %></p>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p class="text-muted">Sin participantes agregados</p>
        <% } %>
      </div>
    </div>

    <!-- Reunión Prebautismal -->
    <div class="card mb-4">
      <div class="card-header bg-primary text-white">Reunión Prebautismal</div>
      <div class="card-body">
        <% if (reunion) { %>
          <div class="row">
            <div class="col-md-4">
              <small class="text-muted">Estado</small>
              <p><%= reunion.estado || '—' %></p>
            </div>
             <div class="col-md-4">
              <small class="text-muted">Catequista asignado</small>
              <p><%= catequista ? `${catequista.nombre} ${catequista.apellido}` : '—' %></p>
            </div>
            <div class="col-md-4">
              <small class="text-muted">Fecha reunión</small>
              <p><%= reunion.fecha ? new Date(reunion.fecha).toLocaleDateString('es-CL') : '—' %></p>
            </div>
           
          </div>
          <div class="mt-3 d-flex gap-2">
            <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalEditarReunion">Editar Reunión</button>
            <form action="/web/tramites/<%= tramite.id %>/completar-reunion" method="POST"
              onsubmit="return confirm('¿Confirmas que la reunión fue completada? Esta acción no se puede deshacer.')">
              <button type="submit" class="btn btn-success btn-sm">Marcar como completada</button>
            </form>
          </div>
        <% } else { %>
          <p class="text-muted">Sin reunión prebautismal registrada</p>
        <% } %>
      </div>
    </div>

    <!-- Modal Editar Reunión -->
    <div class="modal fade" id="modalEditarReunion" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title">Editar Reunión Prebautismal</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <form action="/web/tramites/<%= tramite.id %>/reunion" method="POST">
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label">Catequista</label>
                <select name="id_fk_persona_catequista" class="form-select">
                  <option value="">-- Seleccionar --</option>
                  <% ListaDecatequistas.forEach(function(c) { %>
                    <option value="<%= c.Persona.id %>" <%= reunion && reunion.id_fk_persona_catequista === c.Persona.id ? 'selected' : '' %>>
                      <%= c.Persona.nombre %> <%= c.Persona.apellido %>
                    </option>
                  <% }); %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label">Fecha reunión</label>
                <input type="date" name="fecha" class="form-control"
                  value="<%= reunion ? reunion.fecha || '' : '' %>">
              </div>
              <div class="mb-3">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-select" required>
                  <% estados.forEach(function(e) { %>
                    <option value="<%= e %>" <%= reunion && reunion.estado === e ? 'selected' : '' %>><%= e %></option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Documentos -->
    <div class="card mb-4">
      <div class="card-header bg-primary text-white">Documentos</div>
      <div class="card-body">
        <%
          const tieneDocumentos = participantes && participantes.some(p => p.documento);
        %>
        <% if (tieneDocumentos) { %>
          <% participantes.forEach(function(p) { %>
            <% if (p.documento) { %>
              <div class="mb-3 p-3 border rounded">
                <div class="row">
                  <div class="col-md-3">
                    <small class="text-muted">Participante</small>
                    <p><strong><%= p.Persona.nombre %> <%= p.Persona.apellido %></strong></p>
                  </div>
                  <div class="col-md-3">
                    <small class="text-muted">Tipo de documento</small>
                    <p><%= p.documento.tipo_documento %></p>
                  </div>
                  <div class="col-md-3">
                    <small class="text-muted">Estado</small>
                    <p><%= p.documento.estado_documento %></p>
                  </div>
                  <div class="col-md-3">
                    <small class="text-muted">Fecha entrega</small>
                    <p><%= p.documento.fecha_entrega ? new Date(p.documento.fecha_entrega).toLocaleDateString('es-CL') : '—' %></p>
                  </div>
                </div>
              </div>
            <% } %>
          <% }); %>
        <% } else { %>
          <p class="text-muted">Sin documentos registrados</p>
        <% } %>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
